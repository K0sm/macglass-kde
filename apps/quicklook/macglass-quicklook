#!/usr/bin/env bash
# MacGlass — Quick Look launcher (Dolphin: Space, or right-click → Quick Look).
# Pressing Space again on the same file closes the preview, like macOS.
set -u
f="${1:-}"; [[ -n "$f" ]] || exit 0
f="$(realpath -- "${f#file://}")"
state="${XDG_RUNTIME_DIR:-/tmp}/macglass-quicklook"
if [[ -f "$state.pid" ]] && kill -0 "$(cat "$state.pid")" 2>/dev/null; then
    old="$(cat "$state.file" 2>/dev/null)"
    kill "$(cat "$state.pid")" 2>/dev/null
    [[ "$old" == "$f" ]] && exit 0          # same file → toggle off
fi
[[ -e "$f" ]] || exit 1
mime="$(xdg-mime query filetype "$f" 2>/dev/null || file -b --mime-type -- "$f")"
[[ -d "$f" ]] && mime="inode/directory"
app=""
if desk="$(xdg-mime query default "$mime" 2>/dev/null)" && [[ -n "$desk" ]]; then
    for d in "${XDG_DATA_HOME:-$HOME/.local/share}/applications" /usr/share/applications /var/lib/flatpak/exports/share/applications; do
        [[ -f "$d/$desk" ]] && { app="$(grep -m1 '^Name=' "$d/$desk" | cut -d= -f2-)"; break; }
    done
fi
size="$(du -sh --apparent-size -- "$f" 2>/dev/null | cut -f1)B"
mod="$(date -r "$f" '+%-d %b %Y, %H:%M' 2>/dev/null)"
export QT_QUICK_CONTROLS_STYLE=org.kde.desktop QML_XHR_ALLOW_FILE_READ=1 QT_FORCE_STDERR_LOGGING=1
/usr/lib/qt6/bin/qml "${XDG_DATA_HOME:-$HOME/.local/share}/macglass/quicklook/QuickLook.qml" -- \
    --file "$f" --mime "$mime" --app "$app" --size "$size" --modified "$mod" \
    --output "$(qdbus6 org.kde.KWin /KWin org.kde.KWin.activeOutputName 2>/dev/null)" >/dev/null 2>"$state.log" &
echo $! > "$state.pid"; printf '%s' "$f" > "$state.file"
