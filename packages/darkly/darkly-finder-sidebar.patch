+namespace
+{
+// MacGlass: macOS Finder-style sidebar — the dock is drawn as an inset, rounded glass panel.
+constexpr int FinderGap = 8;      // gap between panel and window/view edges
+constexpr int FinderGapTop = 0;   // the toolbar's own (padded) bottom margin is the gap: 8 px above and below its path field
+constexpr int FinderPad = 6;      // extra padding between panel edge and list items (Finder: ~6-8 px)
+QRect finderPanelRect(const QWidget *dock)
+{
+    const QRect r = dock->rect();
+    const QWidget *win = dock->window();
+    const bool atLeft = dock->x() <= 0;
+    const bool atRight = win && dock->x() + dock->width() >= win->width();
+    return r.adjusted(atLeft || !atRight ? FinderGap : FinderGap / 2, FinderGapTop, atRight ? -FinderGap : -FinderGap / 2, -FinderGap);
+}
+// MacGlass: Dolphin's content area (each DolphinViewContainer, so both halves of a split view) as a rounded card
+constexpr int CardPad = 4; // >= radius * (1 - 1/sqrt(2)) for radius 12, so square children stay inside the corners
+QRect finderCardRect(const QWidget *container)
+{
+    const QWidget *win = container->window();
+    const QPoint pos = win ? container->mapTo(win, QPoint(0, 0)) : QPoint();
+    const bool atLeft = pos.x() <= 0;
+    const bool atRight = !win || pos.x() + container->width() >= win->width();
+    return container->rect().adjusted(atLeft ? FinderGap : FinderGap / 2, FinderGapTop, atRight ? -FinderGap : -FinderGap / 2, -FinderGap);
+}
+void finderUpdateCardMargins(QWidget *container)
+{
+    const QRect r = container->rect(), c = finderCardRect(container);
+    const QMargins m(c.left() - r.left() + CardPad, c.top() - r.top() + CardPad, r.right() - c.right() + CardPad, r.bottom() - c.bottom() + CardPad);
+    if (container->contentsMargins() != m)
+        container->setContentsMargins(m);
+}
+void finderUpdateMargins(QWidget *dock)
+{
+    const QRect r = dock->rect(), p = finderPanelRect(dock);
+    // QDockWidgetLayout ignores the top margin (the title area always starts at y = 0); the top inset is
+    // applied to the panel's content below, with extra room so "Places" doesn't hug the panel's top edge.
+    const QMargins m(p.left() - r.left() + FinderPad, 0, r.right() - p.right() + FinderPad, r.bottom() - p.bottom() + FinderPad);
+    if (dock->contentsMargins() != m)
+        dock->setContentsMargins(m);
+    // Dolphin's locked title bar has a hard-coded 0x0 size hint, so push the panel's content down instead.
+    struct ScrollAreaAccess : QAbstractScrollArea {
+        using QAbstractScrollArea::setViewportMargins;
+        using QAbstractScrollArea::viewportMargins;
+    };
+    const int topInset = p.top() - r.top() + FinderPad + 4;
+    QWidget *dockContent = qobject_cast<QDockWidget *>(dock) ? static_cast<QDockWidget *>(dock)->widget() : nullptr;
+    if (auto *area = qobject_cast<QAbstractScrollArea *>(dockContent)) {
+        auto *access = static_cast<ScrollAreaAccess *>(area);
+        QMargins vm = access->viewportMargins();
+        if (vm.top() != topInset) {
+            vm.setTop(topInset);
+            access->setViewportMargins(vm);
+        }
+    } else if (QWidget *content = dockContent) {
+        QMargins cm = content->contentsMargins();
+        if (cm.top() != topInset) {
+            cm.setTop(topInset);
+            content->setContentsMargins(cm);
+        }
+    }
+}
+
+} // namespace (MacGlass helpers)
