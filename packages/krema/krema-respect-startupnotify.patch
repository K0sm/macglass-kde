+// Desktop Entry Spec: StartupNotify=false means the launched program will not
+// signal completion (e.g. it only toggles an overlay), so no "launching"
+// feedback should be shown for it. Defaults to true when the key is absent.
+bool wantsLaunchFeedback(const QModelIndex &idx, int launcherUrlRole)
+{
+    if (launcherUrlRole < 0)
+        return true;
+    const QUrl url = idx.data(launcherUrlRole).toUrl();
+    QString path;
+    if (url.scheme() == QLatin1String("applications")) {
+        if (const KService::Ptr service = KService::serviceByMenuId(url.path()))
+            path = service->entryPath();
+    } else if (url.isLocalFile()) {
+        path = url.toLocalFile();
+    }
+    if (path.isEmpty() || !KDesktopFile::isDesktopFile(path))
+        return true;
+    return KDesktopFile(path).desktopGroup().readEntry("StartupNotify", true);
+}
+} // namespace
